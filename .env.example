# =============================================================================
# Social Feed Ranking Service — Environment Variables
# =============================================================================
# Copy this file to .env and fill in production values.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=socialfeed
POSTGRES_USER=sfr
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# --- Service Ports ---
GATEWAY_PORT=8000
FEED_SERVICE_PORT=8001
RANKING_ENGINE_PORT=8002
USER_PROFILE_PORT=8003
CONTENT_INGESTION_PORT=8004

# --- Service URLs (for inter-service communication) ---
FEED_SERVICE_URL=http://feed-service:8001
USER_PROFILE_URL=http://user-profile:8003
RANKING_ENGINE_URL=http://ranking-engine:8002

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Ranking Model ---
RANKING_MODEL_PATH=/models/xgboost_v1.json
